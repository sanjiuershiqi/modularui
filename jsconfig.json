{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "moduleDetection": "legacy",
    "strict": false,
    "typeRoots": ["./types", "./node_modules/@types"]
  },
  "include": [
    "types/**/*.d.ts",
    "templates/**/*.js",
    "examples/**/*.js",
    "plugins/**/*.js"
  ],
  "exclude": ["node_modules", ".openchamber"]
}

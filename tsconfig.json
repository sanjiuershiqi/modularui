{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleDetection": "legacy"
  },
  "include": [
    "types/**/*.d.ts",
    "plugins/**/*.ts",
    "examples/**/*.ts"
  ],
  "exclude": ["node_modules", ".openchamber"]
}
